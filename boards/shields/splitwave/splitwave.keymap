#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define UPPER 1
#define LOWER 2

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "DEFAULT";
// -----------------------------------------------------------------------------------------
// | 1  |  2  |  3  |  4  |  5  |                 |  6  |  7   |  8  |  9  |  0  | 
// | Q  |  W  |  E  |  R  |  T  |                 |  Y  |  U   |  I  |  O  |  P  | 
// | A  |  S  |  D  |  F  |  G  |                 |  H  |  J   |  K  |  L  |  ;  | 
// | Z  |  X  |  C  |  V  |  B  | TAB |   | ENTER |  N  |  M   |  ,  |  .  |  /  | 
//         | LSHIFT | LCTRL | SPACE |          | BSPC | LALT | LGUI |
                        bindings = <
                &kp NUMBER_1    &kp NUMBER_2    &kp NUMBER_3    &kp NUMBER_4    &kp NUMBER_5    &kp NUMBER_6    &kp NUMBER_7    &kp NUMBER_8    &kp NUMBER_9    &kp NUMBER_0
                &kp Q    &kp W    &kp E    &kp R    &kp T    &kp Y    &kp U    &kp I    &kp O    &kp P
                &kp A    &kp S    &kp D    &kp F    &kp G    &kp H    &kp J    &kp K    &kp L    &kp SEMI
                &kp Z    &kp X    &kp C    &kp V    &kp B    &kp N    &kp M    &kp COMMA    &kp PERIOD    &kp SLASH
                        &kp LSHFT &kp LCTRL &kp SPACE &kp TAB &lt UPPER ENTER &kp BSPC &kp LALT &kp LGUI
                        >;
                };
                layer_1 {
                        display-name = "UPPER";
// -----------------------------------------------------------------------------------------
// | F1  |  F2 |  F3 |  F4 |  F5 |                 |  F6 |  F7  |  F8  |  F9  | F10 | 
// | F11 | F12 |  -  |  +  | ESC |                 |  "  | PUp  |  up  | PDWN |  |  | 
// | HOME| END |  _  |  =  |  ~  |                 |  '  | left | down | rght |  \  | 
// |  `  |  (  |  {  |  [  |  <  | TAB |   | ENTER |  >  |  }   |   ]  |  )   |  /  | 
//         | LSHIFT | LCTRL | SPACE |          | DEL | LALT | LGUI |
                        bindings = <
                &kp F1    &kp F2    &kp F3     &kp F4     &kp F5     &kp F6    &kp F7     &kp F8    &kp F9      &kp F10
                &kp F11   &kp F12   &kp MINUS  &kp PLUS   &kp ESC    &kp DQT   &kp PG_UP  &kp UP    &kp PG_DN   &kp PIPE
                &kp HOME  &kp END   &kp UNDER  &kp EQUAL  &kp TILDE  &kp SQT   &kp LEFT   &kp DOWN  &kp RIGHT   &kp BSLH
                &kp GRAVE &kp LPAR  &kp LBRC   &kp LBKT   &kp LT     &kp GT    &kp RBRC   &kp RBKT  &kp RPAR    &kp SLASH
                        &kp LSHFT &kp LCTRL &kp SPACE &kp TAB &kp ENTER &kp DEL &kp LALT &kp LGUI
                        >;
                };
        };
        
};
